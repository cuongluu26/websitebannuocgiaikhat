@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">

    <title>Forgot Password</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

    <style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
height:100vh;
display:flex;
justify-content:center;
align-items:center;
background:radial-gradient(circle at top,#1c1c1c,#050505);
overflow:hidden;
}

/* BACKGROUND GLOW EFFECT */
body::before{
content:"";
position:absolute;
width:600px;
height:600px;
background:radial-gradient(circle,#8b5cf6 0%,transparent 70%);
filter:blur(120px);
opacity:0.25;
top:50%;
left:50%;
transform:translate(-50%,-50%);
z-index:0;
}

/* CARD */
form{
position:relative;
z-index:1;
width:380px;
padding:40px;
background:rgba(20,20,20,0.75);
border-radius:25px;
border:1px solid rgba(255,255,255,0.08);
box-shadow:
0 20px 60px rgba(0,0,0,0.6),
0 0 0 1px rgba(255,255,255,0.03);
backdrop-filter:blur(25px);

/* mềm mại hơn */
animation:floatIn .8s ease;
}

/* animation mượt */
@@keyframes floatIn{
from{
opacity:0;
transform:translateY(30px) scale(0.95);
}
to{
opacity:1;
transform:translateY(0) scale(1);
}
}

/* INPUT */
input{
width:100%;
padding:14px;
border-radius:14px;
border:1px solid rgba(255,255,255,0.08);
background:rgba(0,0,0,0.35);
color:white;
font-size:14px;
transition:.3s;
}

input:focus{
outline:none;
border-color:#8b5cf6;
box-shadow:0 0 20px rgba(139,92,246,0.3);
transform:scale(1.02);
}

/* BUTTON */
button{
width:100%;
padding:14px;
margin-top:20px;
border:none;
border-radius:14px;
background:linear-gradient(135deg,#8b5cf6,#6d28d9);
color:white;
font-size:15px;
font-weight:600;
cursor:pointer;
transition:.3s;
}

button:hover{
transform:translateY(-2px) scale(1.02);
box-shadow:0 15px 30px rgba(139,92,246,0.4);
}

button:active{
transform:scale(0.98);
}

/* MESSAGE */
p{
margin-top:15px;
color:#ff6b6b;
font-size:13px;
text-align:center;
}

/* smooth border glow */
form::after{
content:"";
position:absolute;
inset:0;
border-radius:25px;
padding:1px;
background:linear-gradient(135deg,rgba(139,92,246,0.4),transparent);
mask:
linear-gradient(#000 0 0) content-box,
linear-gradient(#000 0 0);
mask-composite:exclude;
pointer-events:none;
}

    </style>

</head>

<body>

    @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post))
    {
        <input type="email" name="Email" placeholder="Nhập Email của bạn" required />
        <button type="submit">Gửi OTP</button>

        if (ViewBag.Message != null)
        {
            <p>@ViewBag.Message</p>
        }
    }

</body>
</html>