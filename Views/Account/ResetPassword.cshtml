
@{
    ViewBag.Title = "ResetPassword";
}

<h2>Đổi mật khẩu mới</h2>

<form method="post" action="@Url.Action("ResetPassword","Account")">

    <input type="password" name="newPassword" placeholder="Nhập mật khẩu mới" required />

    <button type="submit">Xác nhận đổi mật khẩu</button>

</form>

@if (ViewBag.Message != null)
{
    <p>@ViewBag.Message</p>
}
