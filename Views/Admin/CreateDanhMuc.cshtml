@model Wedsite_LTWW.Models.DanhMuc
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h3 class="mb-4">➕ Thêm danh mục</h3>

@using (Html.BeginForm("CreateDanhMuc", "Admin", FormMethod.Post,
        new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="card shadow-sm p-4" style="max-width:600px">

        <div class="mb-3">
            <label class="form-label fw-bold">Tên danh mục</label>
            @Html.TextBoxFor(m => m.TenDanhMuc, new { @class = "form-control", placeholder = "Nhập tên danh mục" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Mô tả</label>
            @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = "3" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Thứ tự</label>
            @Html.TextBoxFor(m => m.ThuTu, new { @class = "form-control", placeholder = "Ví dụ: 1" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Trạng thái</label>
            <select name="TrangThai" class="form-control">
                <option value="true">Hiển thị</option>
                <option value="false">Ẩn</option>
            </select>
        </div>

        <div class="mb-4">
            <label class="form-label fw-bold">Hình ảnh</label>
            <input type="file" name="fileHinh" class="form-control" accept="image/*" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success px-4">
                <i class="fa fa-save"></i> Lưu
            </button>
            <a href="@Url.Action("DanhMuc")" class="btn btn-secondary px-4">
                Hủy
            </a>
        </div>

    </div>
}