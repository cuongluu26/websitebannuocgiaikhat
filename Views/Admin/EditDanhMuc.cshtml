@model Wedsite_LTWW.Models.DanhMuc
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h3 class="mb-4">✏️ Sửa danh mục</h3>

@using (Html.BeginForm("EditDanhMuc", "Admin", FormMethod.Post,
        new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)

    <div class="card shadow-sm p-4" style="max-width:600px">

        <div class="mb-3">
            <label class="form-label fw-bold">Tên danh mục</label>
            @Html.TextBoxFor(m => m.TenDanhMuc, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Mô tả</label>
            @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = "3" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Thứ tự</label>
            @Html.TextBoxFor(m => m.ThuTu, new { @class = "form-control" })
        </div>

        <div class="mb-3">
            <label class="form-label fw-bold">Trạng thái</label>
            <select name="TrangThai" class="form-control">
                <option value="true" @(Model.TrangThai == true ? "selected" : "")>Hiển thị</option>
                <option value="false" @(Model.TrangThai == false ? "selected" : "")>Ẩn</option>
            </select>
        </div>

        <!-- Hình hiện tại -->
        @if (!string.IsNullOrEmpty(Model.HinhAnh))
        {
            <div class="mb-3">
                <label class="form-label fw-bold">Hình hiện tại</label><br />
                <img src="@Url.Content("~/Images/" + Model.HinhAnh)"
                     width="80" height="80" class="rounded border" />
            </div>
        }

        <div class="mb-4">
            <label class="form-label fw-bold">Đổi hình mới (để trống nếu không đổi)</label>
            <input type="file" name="fileHinh" class="form-control" accept="image/*" />
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-warning px-4">
                <i class="fa fa-save"></i> Cập nhật
            </button>
            <a href="@Url.Action("DanhMuc")" class="btn btn-secondary px-4">
                Hủy
            </a>
        </div>

    </div>
}