@model IEnumerable<Wedsite_LTWW.Models.SanPham>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h3 class="mb-3">📦 Quản lý sản phẩm</h3>

<!-- CARD THỐNG KÊ -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="p-3 bg-primary text-white rounded shadow-sm">
            <h6>Tổng sản phẩm</h6>
            <h3>@Model.Count()</h3>
        </div>
    </div>
</div>

<div class="card p-3 mb-3 shadow-sm">
    <form method="get">
        <div class="row g-2">

            <!-- INPUT -->
            <div class="col-md-4">
                <input name="keyword"
                       value="@Request["keyword"]"
                       class="form-control"
                       placeholder="🔍 Tìm sản phẩm..." />
            </div>

            <!-- DANH MỤC -->
            <div class="col-md-3">
                <select name="danhMucId" class="form-control">
                    <option value="">Tất cả danh mục</option>

                    @if (ViewBag.DanhMuc != null)
                    {
                        foreach (var dm in ViewBag.DanhMuc)
                        {
                            <option value="@dm.Id"
                                    @(Request["danhMucId"] == dm.Id.ToString() ? "selected" : "")>
                                @dm.TenDanhMuc
                            </option>
                        }
                    }
                </select>
            </div>

            <!-- BUTTON -->
            <div class="col-md-2">
                <button class="btn btn-primary w-100">
                    <i class="fa fa-search"></i> Tìm
                </button>
            </div>

            <!-- ADD -->
            <div class="col-md-3 text-end">
                <a href="@Url.Action("Create")" class="btn btn-success">
                    + Thêm sản phẩm
                </a>
            </div>

        </div>
    </form>
</div>
<!-- TABLE -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table align-middle table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Hình</th>
                    <th>Tên sản phẩm</th>
                    <th>Giá</th>
                    <th>Thương hiệu</th>
                    <th>Danh mục</th>
                    <th>Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int i = 1;
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted">
                            Không có sản phẩm nào
                        </td>
                    </tr>
                }

                @foreach (var sp in Model)
                {
                    <tr>
                        <td>@i</td>

                        <!-- ẢNH -->
                        <td>
                            <img src="@(string.IsNullOrEmpty(sp.HinhAnh)
                                ? Url.Content("~/Images/no-image.png")
                                : Url.Content("~/Images/" + sp.HinhAnh))"
                                 width="50" height="50"
                                 class="rounded" />
                        </td>

                        <!-- TÊN -->
                        <td>
                            <strong>@sp.TenSanPham</strong>
                        </td>

                        <!-- GIÁ -->
                        <td class="text-primary fw-bold">
                            @String.Format("{0:N0}", sp.Gia) đ
                        </td>

                        <!-- THƯƠNG HIỆU -->
                        <td>@sp.ThuongHieu</td>

                        <!-- DANH MỤC -->
                        <td>
                            @(sp.DanhMuc != null ? sp.DanhMuc.TenDanhMuc : "Không có")
                        </td>

                        <!-- TRẠNG THÁI -->
                        <td>
                            <span class="badge bg-success">Đang bán</span>
                        </td>

                        <!-- ACTION -->
                        <td class="text-center">
                            <a href="@Url.Action("Edit", new { id = sp.Id })"
                               class="btn btn-sm btn-warning">
                                <i class="fa fa-edit"></i>
                            </a>
                            <a href="@Url.Action("XoaSanPham", new { id = sp.Id })"
                               onclick="return confirm('Xóa sản phẩm này?')"
                               class="btn btn-sm btn-danger">
                                <i class="fa fa-trash"></i>
                            </a>
                        </td>
                    </tr>

                    i++;
                }
            </tbody>
        </table>
    </div>
</div>