<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Gas Spark</title>

    <link href="~/Content/StyleSheet1.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/Content/Banner.css">
    <link rel="stylesheet" href="~/Content/Footer.css">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>

<body>

    <!-- BANNER -->
    <div class="top-banner">
        <img src="~/Content/images/banner.gif" />
        <div class="banner-text">NƯỚC GIẢI KHÁT GAS SPARK</div>
    </div>

    <!-- HEADER -->
    <div class="top-header">

        <div class="logo-box">
            <img src="~/Content/images/logo.png" />
            <span>Gas Spark</span>
        </div>

        <!-- SEARCH -->
        <div class="search-box" style="position:relative;">
            <input type="text" id="search-input" placeholder="Nhập sản phẩm cần tìm..."
                   autocomplete="off"
                   onkeydown="if(event.key==='Enter') doSearch()" />
            <button onclick="doSearch()">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>

            <!-- DROPDOWN GỢI Ý -->
            <div id="search-dropdown"
                 style="display:none; position:absolute; top:calc(100% + 6px); left:0; right:0;
                background:white; border-radius:14px;
                box-shadow:0 8px 30px rgba(10,60,255,0.15);
                border:1px solid #e0e8ff; z-index:9999; overflow:hidden; min-width:320px;">
            </div>
        </div>

        <script>
                        var searchTimer = null;

                        document.getElementById('search-input').addEventListener('input', function () {
                            clearTimeout(searchTimer);
                            var q = this.value.trim();
                            var dropdown = document.getElementById('search-dropdown');

                            if (q.length < 1) {
                                dropdown.style.display = 'none';
                                return;
                            }

                            searchTimer = setTimeout(function () {
                                fetch('/Home/GoiY?q=' + encodeURIComponent(q))
                                    .then(function (r) { return r.json(); })
                                    .then(function (data) {
                                        if (data.length === 0) {
                                            dropdown.style.display = 'none';
                                            return;
                                        }

                                        var html = data.map(function (sp) {
                                            return '<a href="/Home/SanPham/' + sp.Id + '" '
                                                + 'style="display:flex;align-items:center;gap:12px;padding:10px 14px;'
                                                + 'text-decoration:none;color:#111;border-bottom:1px solid #f0f2ff;" '
                                                + 'onmouseover="this.style.background=\'#f0f4ff\'" '
                                                + 'onmouseout="this.style.background=\'white\'">'
                                                + '<img src="/Images/' + sp.HinhAnh + '" '
                                                + 'style="width:44px;height:44px;object-fit:contain;'
                                                + 'border-radius:8px;background:#f5f7ff;padding:4px;" />'
                                                + '<div>'
                                                + '<div style="font-size:13px;font-weight:600;margin-bottom:2px;">' + sp.TenSanPham + '</div>'
                                                + '<div style="font-size:13px;color:#e63946;font-weight:700;">'
                                                + parseInt(sp.Gia).toLocaleString('vi-VN') + ' VNĐ</div>'
                                                + '</div></a>';
                                        }).join('');

                                        // Dòng "Xem tất cả"
                                        html += '<a href="/Home/TimKiem?q=' + encodeURIComponent(q) + '" '
                                            + 'style="display:block;text-align:center;padding:10px;'
                                            + 'font-size:13px;color:#0a3cff;font-weight:600;'
                                            + 'text-decoration:none;background:#f8f9ff;" '
                                            + 'onmouseover="this.style.background=\'#eef0ff\'" '
                                            + 'onmouseout="this.style.background=\'#f8f9ff\'">'
                                            + '🔍 Xem tất cả kết quả cho "<b>' + q + '</b>"</a>';

                                        dropdown.innerHTML = html;
                                        dropdown.style.display = 'block';
                                    });
                            }, 300);
                        });

                        // Ẩn dropdown khi click ra ngoài
                        document.addEventListener('click', function (e) {
                            if (!document.getElementById('search-input').contains(e.target)
                                && !document.getElementById('search-dropdown').contains(e.target)) {
                                document.getElementById('search-dropdown').style.display = 'none';
                            }
                        });

                        function doSearch() {
                            var q = document.getElementById('search-input').value.trim();
                            if (q === '') return;
                            window.location.href = '/Home/TimKiem?q=' + encodeURIComponent(q);
                        }
        </script>
        <!-- CART -->
        <a href="@Url.Action("Index","Cart")" class="cart-box" style="text-decoration:none;">
            <div style="position:relative; display:inline-block;">
                <i class="fa-solid fa-cart-shopping"></i>
                @{
                    var cart = Session["GioHang"] as List<Wedsite_LTWW.Models.CartItem>;
                    int tongSL = cart != null ? cart.Sum(x => x.SoLuong) : 0;
                }
                @if (tongSL > 0)
                {
                    <span id="cart-badge" style="
                position:absolute; top:-10px; right:-12px;
                background:#e63946; color:#fff;
                border-radius:50%; width:20px; height:20px;
                font-size:11px; font-weight:700;
                display:flex; align-items:center; justify-content:center;">
                        @tongSL
                    </span>
                }
                else
                {
                    <span id="cart-badge" style="
                position:absolute; top:-10px; right:-12px;
                background:#e63946; color:#fff;
                border-radius:50%; width:20px; height:20px;
                font-size:11px; font-weight:700;
                display:flex; align-items:center; justify-content:center;
                display:none;">0</span>
                }
            </div>
            Giỏ hàng <br />
            <span id="cart-count">@tongSL sản phẩm</span>
        </a>

        <!-- USER -->
        <div class="user-box">

            @if (Session["Username"] == null)
            {
                <a href="@Url.Action("Register","Account")" class="btn-user">
                    <i class="fa-solid fa-user-plus"></i> Đăng ký
                </a>

                <a href="@Url.Action("Login","Account")" class="btn-user">
                    <i class="fa-solid fa-right-to-bracket"></i> Đăng nhập
                </a>
            }
            else
            {
                <span class="user-name">
                    <i class="fa-solid fa-user"></i>
                    Xin chào, @Session["Username"]
                </span>

                <a href="@Url.Action("Logout","Account")" class="logout-btn">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            }

        </div>
        @if (Session["Username"] != null)
        {
            <a href="@Url.Action("DanhSach","YeuThich")" class="btn-user" style="color:#e63946; border-color:#e63946">
                <i class="fa-solid fa-heart"></i> Yêu thích
            </a>
        }
    </div>

    <!-- MENU -->
    <div class="menu-bar">

        <div class="category">
            <i class="fa-solid fa-bars"></i> DANH MỤC
        </div>

        <div class="menu">
            <a href="/">Trang chủ</a>

            <div class="nav-dropdown">
                <a href="#">Sản phẩm <i class="fa fa-angle-down"></i></a>
                <div class="nav-dropdown-content">
                    @if (ViewBag.DanhMuc != null)
                    {
                        foreach (var item in ViewBag.DanhMuc)
                        {
                            <a href="/SanPham/DanhMuc/@item.Id">@item.TenDanhMuc</a>
                        }
                    }
                </div>
            </div>
            <a href="/Home/LienHe">Liên hệ</a>
        </div>

        <div class="hotline">
            <i class="fa-solid fa-phone"></i>
            0916 112 132
        </div>

    </div>

    <!-- HERO -->
    <div class="hero-feature">
        <div class="hero-overlay">

            <div class="hero-feature-box">
                <div class="hero-icon">
                    <i class="fa-solid fa-leaf"></i>
                </div>
                <h3>Tốt cho sức khỏe</h3>
            </div>

            <div class="hero-feature-box">
                <div class="hero-icon">
                    <i class="fa-solid fa-seedling"></i>
                </div>
                <h3>Nông sản tươi từ vườn</h3>
            </div>

            <div class="hero-feature-box">
                <div class="hero-icon">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h3>Luôn luôn an toàn</h3>
            </div>

        </div>
    </div>

    <!-- CONTENT -->
    <div class="content">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="footer">

        <div class="footer-container">

            <div class="footer-col">
                <h3>THÔNG TIN CÔNG TY</h3>
                <img src="/Content/images/logo.png" class="footer-logo">
                <p>
                    Công ty Cổ Phần Thực Phẩm & Nước Giải Khát Gas Spark
                    là một trong những nhà sản xuất nước giải khát hàng đầu Việt Nam.
                </p>
                <p>
                    Xuất khẩu hơn 200 quốc gia và vùng lãnh thổ trên thế giới.
                </p>
            </div>

            <div class="footer-col box">
                <h3>CHÍNH SÁCH</h3>
                <ul>
                    <li><a href="/Home/ChinhSachGiaoHang">Chính sách giao hàng</a></li>
                    <li><a href="/Home/ChinhSachKiemHang">Chính sách kiểm hàng</a></li>
                    <li><a href="/Home/ChinhSachDoiTra">Chính sách đổi trả</a></li>
                    <li><a href="/Home/ChinhSachThanhToan">Chính sách thanh toán</a></li>
                </ul>
            </div>

            <div class="footer-col box">
                <h3>VỀ CHÚNG TÔI</h3>
                <ul>
                    <li>Quy mô và thị trường</li>
                    <li>Tầm nhìn - Sứ mệnh - Giá trị cốt lõi</li>
                    <li>Chứng nhận chất lượng</li>
                </ul>
            </div>

            <div class="footer-col">
                <h3>ĐÃ ĐĂNG KÝ</h3>
                <img src="/Content/images/bocongthuong.png" class="footer-bct">
            </div>

        </div>

        <div class="footer-bottom">
            <p>Copyright © 2026 Gas Spark. All Rights Reserved.</p>
        </div>

    </footer>
    <style>
        .nav-dropdown-content {
            display: none !important;
            position: absolute !important;
            top: 100% !important;
            left: 0 !important;
            background: #fff !important;
            min-width: 220px !important;
            border-radius: 10px !important;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15) !important;
            padding: 10px 0 !important;
            z-index: 99999 !important;
        }

            .nav-dropdown-content.show {
                display: block !important;
            }

        .nav-dropdown {
            position: relative !important;
        }

            .nav-dropdown > a {
                display: flex !important;
                align-items: center !important;
                gap: 5px !important;
                white-space: nowrap !important;
            }

        .nav-dropdown-content a {
            display: block !important;
            padding: 10px 20px !important;
            color: #333 !important;
            text-decoration: none !important;
            transform: none !important;
            background: transparent !important;
        }

            .nav-dropdown-content a:hover {
                background: #f0f4ff !important;
                color: #0a3cff !important;
                padding-left: 26px !important;
                transform: none !important;
            }
    </style>

    <script>
                var dropdown = document.querySelector('.nav-dropdown');
                var content = document.querySelector('.nav-dropdown-content');

                dropdown.addEventListener('mouseenter', function () {
                    content.classList.add('show');
                });

                dropdown.addEventListener('mouseleave', function () {
                    content.classList.remove('show');
                });
    </script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @RenderSection("Scripts", required: false)
    <!-- CHATBOT -->
    <div id="chatbot-container">

        <!-- Nút mở chat -->
        <div id="chatbot-toggle">
            <i class="fa-solid fa-comment-dots"></i>
        </div>

        <!-- Khung chat -->
        <div id="chatbot-box">

            <div class="chat-header">
                <span>Gas Spark Chat</span>
                <button id="chat-close">✕</button>
            </div>

            <div id="chat-messages"></div>

            <div class="chat-input">
                <input type="text" id="chat-input" placeholder="Nhập tin nhắn..." />
                <button onclick="sendMessage()">Gửi</button>
            </div>

        </div>
    </div>

    <style>

        #chatbot-container {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 999999;
            font-family: Arial;
        }

        #chatbot-toggle {
            width: 60px;
            height: 60px;
            background: #0a3cff;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            cursor: pointer;
            box-shadow: 0 6px 20px rgba(0,0,0,0.2);
        }

        #chatbot-box {
            display: none;
            flex-direction: column;
            width: 320px;
            height: 420px;
            background: white;
            border-radius: 14px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.25);
            margin-bottom: 10px;
            overflow: hidden;
        }

        .chat-header {
            background: #0a3cff;
            color: white;
            padding: 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: bold;
        }

        #chat-messages {
            flex: 1;
            overflow-y: auto;
            padding: 10px;
            background: #f5f7ff;
        }

        .msg-user {
            background: #0a3cff;
            color: white;
            padding: 8px 12px;
            border-radius: 12px;
            margin: 6px 0;
            display: inline-block;
            float: right;
            clear: both;
        }

        .msg-bot {
            background: white;
            border: 1px solid #ddd;
            padding: 8px 12px;
            border-radius: 12px;
            margin: 6px 0;
            display: inline-block;
            float: left;
            clear: both;
        }

        .chat-input {
            display: flex;
            border-top: 1px solid #eee;
        }

            .chat-input input {
                flex: 1;
                border: none;
                padding: 10px;
                outline: none;
            }

            .chat-input button {
                background: #0a3cff;
                color: white;
                border: none;
                padding: 10px 14px;
                cursor: pointer;
            }
    </style>

    <script>

                document.addEventListener("DOMContentLoaded", function () {

                    var toggle = document.getElementById("chatbot-toggle");
                    var box = document.getElementById("chatbot-box");
                    var closeBtn = document.getElementById("chat-close");
                    var input = document.getElementById("chat-input");

                    toggle.onclick = function () {

                        if (box.style.display === "flex") {
                            box.style.display = "none";
                        } else {
                            box.style.display = "flex";
                        }

                    };

                    closeBtn.onclick = function () {
                        box.style.display = "none";
                    };

                    input.addEventListener("keypress", function (e) {
                        if (e.key === "Enter") {
                            sendMessage();
                        }
                    });

                });


                function addMessage(text, type) {

                    var div = document.createElement("div");

                    div.className = type === "user" ? "msg-user" : "msg-bot";

                    div.innerText = text;

                    var box = document.getElementById("chat-messages");

                    box.appendChild(div);

                    box.scrollTop = box.scrollHeight;

                }


                function sendMessage() {

                    var input = document.getElementById("chat-input");

                    var msg = input.value.trim();

                    if (msg === "") return;

                    addMessage(msg, "user");

                    input.value = "";

                    fetch("/ChatAI/Ask", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            message: msg
                        })
                    })
                        .then(response => response.json())
                        .then(data => {

                            if (data.reply) {
                                addMessage(data.reply, "bot");
                            } else {
                                addMessage("AI không trả lời.", "bot");
                            }

                        })
                        .catch(error => {

                            console.log(error);

                            addMessage("Không kết nối được AI.", "bot");

                        });

                }

    </script>
</body>
</html>