@{
    var cart = Session["GioHang"] as List<Wedsite_LTWW.Models.CartItem>;
    int tongSL = cart != null ? cart.Sum(x => x.SoLuong) : 0;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Gas Spark</title>

    <!-- Font hỗ trợ đầy đủ dấu tiếng Việt -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="~/Content/Banner.css" rel="stylesheet" />
    <link href="~/Content/Footer.css" rel="stylesheet" />
    <!-- Luôn đặt SAU CÙNG để đè lên các file trên -->
    <link href="~/Content/site.css" rel="stylesheet" />
</head>

<body>

    <!-- BANNER -->
    <div class="top-banner">
        <img src="~/Content/Images/banner.gif" alt="Gas Spark">

        <h1 class="banner-text">
            NƯỚC GIẢI KHÁT GAS SPARK
        </h1>
    </div>

    <!-- HEADER -->
    <div class="top-header">

        <div class="logo-box">
            <img src="~/Content/images/logo.png" alt="Gas Spark" />
            <span>Gas Spark</span>
        </div>

        <!-- SEARCH -->
        <div class="search-box" style="position:relative;">
            <input type="text" id="search-input" placeholder="Nhập sản phẩm cần tìm..."
                   autocomplete="off"
                   onkeydown="if(event.key==='Enter') doSearch()" />
            <button type="button" onclick="doSearch()" aria-label="Tìm kiếm">
                <i class="fa-solid fa-magnifying-glass"></i>
            </button>

            <!-- DROPDOWN GỢI Ý -->
            <div id="search-dropdown"></div>
        </div>

        <!-- CART -->
        <a href="@Url.Action("Index","Cart")" class="cart-box">
            <div class="cart-icon">
                <i class="fa-solid fa-cart-shopping"></i>
                @if (tongSL > 0)
                {
                    <span id="cart-badge" class="cart-badge">@tongSL</span>
                }
                else
                {
                    <span id="cart-badge" class="cart-badge" style="display:none;">0</span>
                }
            </div>
            <div class="cart-text">
                Giỏ hàng<br />
                <span id="cart-count">@tongSL sản phẩm</span>
            </div>
        </a>

        <!-- USER -->
        <div class="user-box">
            @if (Session["Username"] == null)
            {
                <a href="@Url.Action("Register","Account")" class="btn-user">
                    <i class="fa-solid fa-user-plus"></i> Đăng ký
                </a>
                <a href="@Url.Action("Login","Account")" class="btn-user">
                    <i class="fa-solid fa-right-to-bracket"></i> Đăng nhập
                </a>
            }
            else
            {
                <span class="user-name">
                    <i class="fa-solid fa-user"></i>
                    Xin chào, @Session["Username"]
                </span>
                <a href="@Url.Action("DanhSach","YeuThich")" class="btn-user btn-user--fav">
                    <i class="fa-solid fa-heart"></i> Yêu thích
                </a>
                <a href="@Url.Action("LichSu","DonHang")" class="btn-user">
                    <i class="fa-solid fa-box"></i> Đơn hàng
                </a>
                <a href="@Url.Action("Logout","Account")" class="logout-btn" title="Đăng xuất" aria-label="Đăng xuất">
                    <i class="fa-solid fa-right-from-bracket"></i>
                </a>
            }
        </div>
    </div>

    <!-- MENU -->
    <div class="menu-bar">

        <div class="category">
            <i class="fa-solid fa-bars"></i> DANH MỤC
        </div>

        <div class="menu">
            <a href="/">Trang chủ</a>

            <div class="nav-dropdown">
                <a href="#">Sản phẩm <i class="fa fa-angle-down"></i></a>
                <div class="nav-dropdown-content">
                    @if (ViewBag.DanhMuc != null)
                    {
                        foreach (var item in ViewBag.DanhMuc)
                        {
                            <a href="/SanPham/DanhMuc/@item.Id">@item.TenDanhMuc</a>
                        }
                    }
                </div>
            </div>
            <a href="@Url.Action("Index", "KhuyenMai")">Khuyến mãi</a>
            <a href="/Home/LienHe">Liên hệ</a>
        </div>

        <div class="hotline">
            <i class="fa-solid fa-phone"></i>
            0000 8888
        </div>

    </div>
    <!-- HERO -->
    @if (ViewBag.HideHero != true)
    {
        <div class="hero-feature">
            <div class="hero-overlay">

                <div class="hero-feature-box">
                    <div class="hero-icon">
                        <i class="fa-solid fa-leaf"></i>
                    </div>
                    <h3>Tốt cho sức khỏe</h3>
                </div>

                <div class="hero-feature-box">
                    <div class="hero-icon">
                        <i class="fa-solid fa-seedling"></i>
                    </div>
                    <h3>Nông sản tươi từ vườn</h3>
                </div>

                <div class="hero-feature-box">
                    <div class="hero-icon">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <h3>Luôn luôn an toàn</h3>
                </div>

            </div>
        </div>
    }

    <!-- CONTENT -->
    <div class="content">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="footer">

        <div class="footer-container">

            <div class="footer-col">
                <h3>THÔNG TIN CÔNG TY</h3>
                <img src="/Content/images/logo.png" class="footer-logo" alt="Gas Spark">
                <p>
                    Công ty Cổ Phần Thực Phẩm & Nước Giải Khát Gas Spark
                    là một trong những nhà sản xuất nước giải khát hàng đầu Việt Nam.
                </p>
                <p>
                    Xuất khẩu hơn 200 quốc gia và vùng lãnh thổ trên thế giới.
                </p>
            </div>

            <div class="footer-col box">
                <h3>CHÍNH SÁCH</h3>
                <ul>
                    <li><a href="/Home/ChinhSachGiaoHang">Chính sách giao hàng</a></li>
                    <li><a href="/Home/ChinhSachKiemHang">Chính sách kiểm hàng</a></li>
                    <li><a href="/Home/ChinhSachDoiTra">Chính sách đổi trả</a></li>
                    <li><a href="/Home/ChinhSachThanhToan">Chính sách thanh toán</a></li>
                </ul>
            </div>


            <div class="footer-col box">
                <h3>VỀ CHÚNG TÔI</h3>
                <ul>
                    <li><a href="/Home/QuyMoVaThiTruong">Quy mô và thị trường</a></li>
                    <li><a href="/Home/TamNhin#tam-nhin-su-menh">Tầm nhìn - Sứ mệnh - Giá trị cốt lõi</a></li>
                    <li><a href="/Home/QuyMoVaThiTruong#chung-nhan-quoc-te">Chứng nhận chất lượng</a></li>
                </ul>
            </div>


            <div class="footer-col">
                <h3>ĐÃ ĐĂNG KÝ</h3>
                <img src="/Content/images/bocongthuong.png" class="footer-bct" alt="Đã đăng ký Bộ Công Thương">
            </div>

        </div>

        <div class="footer-bottom">
            <p>Copyright © 2026 Gas Spark. All Rights Reserved.</p>
        </div>

    </footer>

    <!-- CHATBOT -->
    <div id="chatbot-container">

        <!-- Khung chat -->
        <div id="chatbot-box">

            <div class="chat-header">
                <span>Gas Spark Chat</span>
                <button type="button" id="chat-close" aria-label="Đóng">✕</button>
            </div>

            <div id="chat-messages"></div>

            <div class="chat-input">
                <input type="text" id="chat-input" placeholder="Nhập tin nhắn..." />
                <button type="button" onclick="sendMessage()">Gửi</button>
            </div>

        </div>

        <!-- Nút mở chat -->
        <div id="chatbot-toggle" role="button" aria-label="Mở chat">
            <i class="fa-solid fa-comment-dots"></i>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @RenderSection("Scripts", required: false)

    <script>
                        /* ===== Chống XSS khi chèn chuỗi vào innerHTML ===== */
                        function esc(s) {
                            return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
                                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                            });
                        }

                        /* ===== Tìm kiếm + gợi ý ===== */
                        var searchTimer = null;
                        var searchInput = document.getElementById('search-input');
                        var searchDropdown = document.getElementById('search-dropdown');

                        searchInput.addEventListener('input', function () {
                            clearTimeout(searchTimer);
                            var q = this.value.trim();

                            if (q.length < 1) {
                                searchDropdown.style.display = 'none';
                                return;
                            }

                            searchTimer = setTimeout(function () {
                                fetch('/Home/GoiY?q=' + encodeURIComponent(q))
                                    .then(function (r) { return r.json(); })
                                    .then(function (data) {
                                        if (data.length === 0) {
                                            searchDropdown.style.display = 'none';
                                            return;
                                        }

                                        var html = data.map(function (sp) {
                                            return '<a class="sd-item" href="/Home/SanPham/' + encodeURIComponent(sp.Id) + '">'
                                                + '<img class="sd-img" src="/Images/' + esc(sp.HinhAnh) + '" alt="" />'
                                                + '<div>'
                                                + '<div class="sd-name">' + esc(sp.TenSanPham) + '</div>'
                                                + '<div class="sd-price">' + parseInt(sp.Gia).toLocaleString('vi-VN') + ' VNĐ</div>'
                                                + '</div></a>';
                                        }).join('');

                                        html += '<a class="sd-all" href="/Home/TimKiem?q=' + encodeURIComponent(q) + '">'
                                            + '<i class="fa-solid fa-magnifying-glass"></i> Xem tất cả kết quả cho "<b>' + esc(q) + '</b>"</a>';

                                        searchDropdown.innerHTML = html;
                                        searchDropdown.style.display = 'block';
                                    });
                            }, 300);
                        });

                        // Ẩn dropdown khi click ra ngoài
                        document.addEventListener('click', function (e) {
                            if (!searchInput.contains(e.target) && !searchDropdown.contains(e.target)) {
                                searchDropdown.style.display = 'none';
                            }
                        });

                        function doSearch() {
                            var q = searchInput.value.trim();
                            if (q === '') return;
                            window.location.href = '/Home/TimKiem?q=' + encodeURIComponent(q);
                        }

                        /* ===== Menu Sản phẩm (hover) ===== */
                        (function () {
                            var dropdown = document.querySelector('.nav-dropdown');
                            var content = document.querySelector('.nav-dropdown-content');
                            if (!dropdown || !content) return;

                            dropdown.addEventListener('mouseenter', function () { content.classList.add('show'); });
                            dropdown.addEventListener('mouseleave', function () { content.classList.remove('show'); });
                        })();

/* ===== Chatbot ===== */
document.addEventListener("DOMContentLoaded", function () {

            var toggle = document.getElementById("chatbot-toggle");
            var box = document.getElementById("chatbot-box");
            var closeBtn = document.getElementById("chat-close");
            var input = document.getElementById("chat-input");
            var list = document.getElementById("chat-messages");
            var greeted = false;

            // Tải lại tin nhắn cũ của tài khoản từ server
            fetch("/ChatAI/History", { credentials: "same-origin" })
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    var msgs = data.messages || [];
                    if (msgs.length > 0) {
                        greeted = true;   // đã có lịch sử thì không chào lại
                        msgs.forEach(function (m) {
                            addMessage(m.text, m.role === "user" ? "user" : "bot");
                        });
                    }
                })
                .catch(function (e) { console.log(e); });

            toggle.onclick = function () {
                if (box.style.display === "flex") {
                    box.style.display = "none";
                } else {
                    box.style.display = "flex";
                    if (!greeted) {
                        greeted = true;
                        addMessage("Xin chào! Mình là trợ lý của Gas Spark 🥤 Bạn muốn tìm loại nước nào hôm nay?", "bot");
                    }
                    list.scrollTop = list.scrollHeight;
                    input.focus();
                }
            };

            closeBtn.onclick = function () {
                box.style.display = "none";
            };

            input.addEventListener("keypress", function (e) {
                if (e.key === "Enter") {
                    sendMessage();
                }
            });
});

                        function addMessage(text, type) {
                            var div = document.createElement("div");
                            div.className = type === "user" ? "msg-user" : "msg-bot";
                            div.innerText = text;

                            var box = document.getElementById("chat-messages");
                            box.appendChild(div);
                            box.scrollTop = box.scrollHeight;
                            return div;
                        }

                        function renderProducts(products) {
                            if (!products || !products.length) return;

                            var container = document.getElementById("chat-messages");
                            var wrap = document.createElement("div");
                            wrap.className = "chat-products";

                            products.forEach(function (p) {
                                var card = document.createElement("div");
                                card.className = "chat-product-card";

                                var img = document.createElement("img");
                                img.src = p.hinhAnh;
                                img.alt = p.ten;

                                var info = document.createElement("div");
                                info.className = "cp-info";

                                var name = document.createElement("div");
                                name.className = "cp-name";
                                name.textContent = p.ten;

                                var price = document.createElement("div");
                                price.className = "cp-price";
                                price.textContent = p.gia;

                                var a = document.createElement("a");
                                a.href = p.link;
                                a.className = "cp-btn";
                                a.textContent = "Xem chi tiết";

                                info.appendChild(name);
                                info.appendChild(price);
                                info.appendChild(a);
                                card.appendChild(img);
                                card.appendChild(info);
                                wrap.appendChild(card);
                            });

                            container.appendChild(wrap);
                            container.scrollTop = container.scrollHeight;
                        }

                        var chatBusy = false;

                        function sendMessage() {
                            if (chatBusy) return;

                            var input = document.getElementById("chat-input");
                            var msg = input.value.trim();
                            if (msg === "") return;

                            addMessage(msg, "user");
                            input.value = "";

                            chatBusy = true;
                            var typing = addMessage("Đang trả lời...", "bot");
                            typing.classList.add("msg-typing");

                            fetch("/ChatAI/Ask", {
                                method: "POST",
                                headers: { "Content-Type": "application/json" },
                                body: JSON.stringify({ message: msg })
                            })
                                .then(function (response) { return response.json(); })
                                .then(function (data) {
                                    typing.remove();
                                    addMessage(data.reply ? data.reply : "AI không trả lời.", "bot");
                                    renderProducts(data.products);
                                })
                                .catch(function (error) {
                                    console.log(error);
                                    typing.remove();
                                    addMessage("Không kết nối được AI.", "bot");
                                })
                                .finally(function () {
                                    chatBusy = false;
                                });
                        }
    </script>
</body>
</html>
