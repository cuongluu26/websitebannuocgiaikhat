<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            background: #f4f6fb;
        }

        .sidebar {
            width: 240px;
            height: 100vh;
            background: #0d1b2a;
            position: fixed;
            color: white;
        }

            .sidebar a {
                color: #cbd5e1;
                display: block;
                padding: 12px;
                text-decoration: none;
            }

                .sidebar a:hover {
                    background: #1b263b;
                    color: white;
                }
        .bg-purple {
            background: #8b5cf6;
        }
        .content {
            margin-left: 240px;
            padding: 20px;

    </style>
</head>

<body>

    <<div class="sidebar">
    <h4 class="p-3">⚡ Gas Spark</h4>

    <a href="@Url.Action("Index","Admin")">
        <i class="fa fa-chart-bar"></i> Dashboard
    </a>

    <a href="@Url.Action("SanPham","Admin")">
        <i class="fa fa-box"></i> Sản phẩm
    </a>

    <a href="@Url.Action("DanhMuc","Admin")">
        <i class="fa fa-list"></i> Danh mục
    </a>

    <a href="@Url.Action("DonHang","Admin")">
        <i class="fa fa-shopping-cart"></i> Đơn hàng
    </a>

    <a href="@Url.Action("User","Admin")">
        <i class="fa fa-user"></i> Người dùng
    </a>

    <a href="@Url.Action("LienHe","Admin")">
        <i class="fa fa-envelope"></i> Liên hệ
    </a>
</div>
    <div class="content">
        @RenderBody()
    </div>

</body>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</html>