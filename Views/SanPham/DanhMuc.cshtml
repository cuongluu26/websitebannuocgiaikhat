
@model List<Wedsite_LTWW.Models.SanPham>

@{
    decimal? giaMin = ViewBag.GiaMin as decimal?;
    decimal? giaMax = ViewBag.GiaMax as decimal?;
    string sapXep = ViewBag.SapXep as string ?? "macdinh";

    int currentPage = Convert.ToInt32(ViewBag.CurrentPage ?? 1);
    int totalPages = Convert.ToInt32(ViewBag.TotalPages ?? 1);
    int tongSoSanPham = Convert.ToInt32(ViewBag.TongSoSanPham ?? 0);

    bool q1 = !giaMin.HasValue && giaMax == 30000m;
    bool q2 = giaMin == 30000m && giaMax == 50000m;
    bool q3 = giaMin == 50000m && !giaMax.HasValue;

    object categoryRouteId = ViewContext.RouteData.Values["id"];
}

<style>
    .hero-feature {
        display: none !important;
    }

    /* BỘ LỌC GIÁ */
    .filter-panel {
        margin: 0 0 26px;
        padding: 24px;
        background: var(--gs-surface);
        border: 1px solid var(--gs-line);
        border-radius: var(--gs-r-md);
        box-shadow: var(--gs-sh-sm);
    }

    .filter-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        font-size: 18px;
        font-weight: 700;
        color: var(--gs-blue-900);
    }

        .filter-heading i {
            color: var(--gs-blue-500);
        }

    .filter-form {
        display: grid;
        grid-template-columns: 1fr 1fr 1.1fr auto auto;
        align-items: end;
        gap: 14px;
    }

    .filter-field label {
        display: block;
        margin-bottom: 7px;
        font-size: 13px;
        font-weight: 600;
        color: var(--gs-muted);
    }

    .filter-input,
    .filter-select {
        width: 100%;
        height: 46px;
        padding: 0 14px;
        border: 1px solid var(--gs-line);
        border-radius: var(--gs-r-sm);
        background: #f8faff;
        color: var(--gs-ink);
        font-size: 14px;
        outline: none;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }

        .filter-input:hover,
        .filter-select:hover {
            border-color: #c9d6f5;
        }

        .filter-input:focus,
        .filter-select:focus {
            border-color: var(--gs-blue-700);
            background: #fff;
            box-shadow: 0 0 0 4px rgba(10, 60, 255, .12);
        }

    .filter-btn,
    .reset-btn {
        height: 46px;
        padding: 0 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: var(--gs-r-sm);
        font-size: 14px;
        font-weight: 600;
        white-space: nowrap;
        cursor: pointer;
        text-decoration: none !important;
        transition: transform .2s, box-shadow .2s, border-color .2s, color .2s;
    }

    .filter-btn {
        border: 0;
        color: #fff !important;
        background: linear-gradient(135deg, var(--gs-blue-500), var(--gs-blue-700));
        box-shadow: 0 8px 16px -8px rgba(10, 60, 255, .7);
    }

        .filter-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 12px 20px -8px rgba(10, 60, 255, .75);
        }

    .reset-btn {
        border: 1px solid var(--gs-line);
        background: #fff;
        color: var(--gs-text) !important;
    }

        .reset-btn:hover {
            border-color: var(--gs-blue-700);
            color: var(--gs-blue-700) !important;
        }

    /* MỨC GIÁ NHANH */
    .quick-prices {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        margin-top: 18px;
        padding-top: 18px;
        border-top: 1px solid var(--gs-line);
    }

    .quick-label {
        margin-right: 4px;
        font-size: 13px;
        font-weight: 600;
        color: var(--gs-muted);
    }

    .quick-price {
        padding: 8px 15px;
        border: 1px solid transparent;
        border-radius: 999px;
        background: var(--gs-blue-100);
        color: var(--gs-blue-700) !important;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none !important;
        transition: background .2s, color .2s;
    }

        .quick-price:hover,
        .quick-price.active {
            background: var(--gs-blue-700);
            color: #fff !important;
        }

    /* THANH THÔNG TIN */
    .product-toolbar {
        margin-bottom: 18px;
    }

    .result-count {
        font-size: 14px;
        color: var(--gs-muted);
    }

        .result-count strong {
            color: var(--gs-ink);
        }

    /* KHÔNG CÓ SẢN PHẨM */
    .empty-box {
        padding: 64px 20px;
        text-align: center;
        color: var(--gs-muted);
        background: #fafcff;
        border: 1px dashed #c9d6f5;
        border-radius: var(--gs-r-md);
    }

        .empty-box i {
            margin-bottom: 16px;
            font-size: 48px;
            color: #b8cce7;
        }

        .empty-box p {
            margin: 0 0 18px;
            font-size: 16px;
        }

    /* PHÂN TRANG */
    .pagination-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 9px;
        margin: 40px 0 30px;
        flex-wrap: wrap;
    }

        .pagination-container a,
        .pagination-container span {
            min-width: 42px;
            height: 42px;
            padding: 0 13px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            border: 1px solid var(--gs-line);
            background: #fff;
            color: var(--gs-blue-700);
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            transition: all .25s ease;
        }

            .pagination-container a:hover {
                background: var(--gs-blue-100);
                border-color: var(--gs-blue-500);
                transform: translateY(-2px);
            }

            .pagination-container a.active {
                color: #fff;
                border-color: transparent;
                background: linear-gradient(135deg, var(--gs-blue-500), var(--gs-blue-700));
                box-shadow: 0 5px 13px rgba(10, 60, 255, .25);
            }

    .pagination-info {
        margin-top: 14px;
        text-align: center;
        color: var(--gs-muted);
        font-size: 13px;
    }

    @@media (max-width: 1100px) {
        .filter-form {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .filter-field.sort-field {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 560px) {
        .filter-panel {
            padding: 16px;
        }

        .filter-btn,
        .reset-btn {
            width: 100%;
        }
    }
</style>

<!-- TIÊU ĐỀ DANH MỤC -->
<div class="page-hero">
    <h2>
        <i class="fa-solid fa-tag"></i>
        @ViewBag.TenDanhMuc
    </h2>
    <p>Khám phá sản phẩm yêu thích với mức giá phù hợp</p>
</div>

<!-- BỘ LỌC GIÁ -->
<div class="filter-panel">

    <div class="filter-heading">
        <i class="fa-solid fa-sliders"></i>
        Lọc sản phẩm
    </div>

    @using (Html.BeginForm(
        "DanhMuc",
        "SanPham",
        new { id = categoryRouteId },
        FormMethod.Get,
        new { @class = "filter-form" }))
    {
        <div class="filter-field">
            <label for="giaMin">Giá thấp nhất (VNĐ)</label>

            <input class="filter-input"
                   type="number"
                   id="giaMin"
                   name="giaMin"
                   min="0"
                   step="1000"
                   placeholder="Ví dụ: 10000"
                   value="@(giaMin.HasValue ? giaMin.Value.ToString("0.##") : "")" />
        </div>

        <div class="filter-field">
            <label for="giaMax">Giá cao nhất (VNĐ)</label>

            <input class="filter-input"
                   type="number"
                   id="giaMax"
                   name="giaMax"
                   min="0"
                   step="1000"
                   placeholder="Ví dụ: 50000"
                   value="@(giaMax.HasValue ? giaMax.Value.ToString("0.##") : "")" />
        </div>

        <div class="filter-field sort-field">
            <label for="sapXep">Sắp xếp sản phẩm</label>

            <select class="filter-select" id="sapXep" name="sapXep">
                <option value="macdinh" @(sapXep == "macdinh" ? "selected" : "")>
                    Mặc định
                </option>

                <option value="tang" @(sapXep == "tang" ? "selected" : "")>
                    Giá thấp đến cao
                </option>

                <option value="giam" @(sapXep == "giam" ? "selected" : "")>
                    Giá cao đến thấp
                </option>
            </select>
        </div>

        <button class="filter-btn" type="submit">
            <i class="fa-solid fa-filter"></i>
            Lọc giá
        </button>

        <a class="reset-btn"
           href="@Url.Action("DanhMuc", "SanPham", new { id = categoryRouteId })">
            <i class="fa-solid fa-rotate-left"></i>
            Xóa lọc
        </a>
    }

    <!-- MỨC GIÁ NHANH -->
    <div class="quick-prices">
        <span class="quick-label">Mức giá nhanh:</span>

        <a class="quick-price@(q1 ? " active" : "")"
           href="@Url.Action("DanhMuc", "SanPham", new {
                id = categoryRouteId,
                giaMax = 30000
           })">
            Dưới 30.000đ
        </a>

        <a class="quick-price@(q2 ? " active" : "")"
           href="@Url.Action("DanhMuc", "SanPham", new {
                id = categoryRouteId,
                giaMin = 30000,
                giaMax = 50000
           })">
            30.000đ – 50.000đ
        </a>

        <a class="quick-price@(q3 ? " active" : "")"
           href="@Url.Action("DanhMuc", "SanPham", new {
                id = categoryRouteId,
                giaMin = 50000
           })">
            Từ 50.000đ
        </a>
    </div>
</div>

<!-- THÔNG TIN SẢN PHẨM -->
<div class="product-toolbar">
    <div class="result-count">
        Danh mục:
        <strong>@ViewBag.TenDanhMuc</strong>

        &nbsp;|&nbsp;

        Tìm thấy:
        <strong>@tongSoSanPham</strong>
        sản phẩm
    </div>
</div>

<!-- DANH SÁCH SẢN PHẨM -->
@if (!Model.Any())
{
    <div class="empty-box">
        <i class="fa-solid fa-box-open"></i>

        <p>Không tìm thấy sản phẩm phù hợp với bộ lọc giá.</p>

        <a class="reset-btn"
           href="@Url.Action("DanhMuc", "SanPham", new { id = categoryRouteId })">
            Xem tất cả sản phẩm
        </a>
    </div>
}
else
{
    <div class="product-grid">

        @foreach (var item in Model)
        {
            <a href="@Url.Action("SanPham", "Home", new { id = item.Id })"
               class="product-card">

                <div class="product-image">
                    <img src="@Url.Content("~/Images/" + item.HinhAnh)"
                         alt="@item.TenSanPham" />
                </div>

                <div class="product-info">
                    <p class="product-name">
                        @item.TenSanPham
                    </p>

                    <p class="product-price">
                        @String.Format("{0:N0}", item.Gia) VNĐ
                    </p>
                </div>

                <span class="product-btn">
                    <i class="fa-solid fa-cart-shopping"></i>
                    Xem chi tiết
                </span>

            </a>
        }

    </div>
}

<!-- PHÂN TRANG: ĐẶT NGOÀI IF / ELSE ĐỂ TRÁNH LỖI RAZOR -->
@if (Model.Any() && totalPages > 1)
{
    <div class="pagination-container">

        @if (currentPage > 1)
        {
            <a href="@Url.Action("DanhMuc", "SanPham", new {
                id = categoryRouteId,
                page = currentPage - 1,
                giaMin = giaMin,
                giaMax = giaMax,
                sapXep = sapXep
            })"
               title="Trang trước">
                <i class="fa-solid fa-chevron-left"></i>
            </a>
        }

        @for (int i = 1; i <= totalPages; i++)
        {
            <a href="@Url.Action("DanhMuc", "SanPham", new {
                id = categoryRouteId,
                page = i,
                giaMin = giaMin,
                giaMax = giaMax,
                sapXep = sapXep
            })"
               class="@(i == currentPage ? "active" : "")">
                @i
            </a>
        }

        @if (currentPage < totalPages)
        {
            <a href="@Url.Action("DanhMuc", "SanPham", new {
                id = categoryRouteId,
                page = currentPage + 1,
                giaMin = giaMin,
                giaMax = giaMax,
                sapXep = sapXep
            })"
               title="Trang tiếp">
                <i class="fa-solid fa-chevron-right"></i>
            </a>
        }

    </div>

    <div class="pagination-info">
        Trang @currentPage / @totalPages
        · Hiển thị tối đa 10 sản phẩm mỗi trang
    </div>
}
