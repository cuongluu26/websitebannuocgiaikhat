@model Wedsite_LTWW.Models.SanPham

@{
    ViewBag.Title = Model.TenSanPham;
}

<style>
    .hero-feature {
        display: none !important;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 24px;
        padding: 8px 16px;
        border-radius: 999px;
        background: var(--gs-blue-100);
        color: var(--gs-blue-700);
        font-size: 14px;
        font-weight: 600;
        transition: background .2s, color .2s;
    }

        .btn-back:hover {
            background: var(--gs-blue-700);
            color: #fff;
        }

    .detail-wrapper {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: clamp(28px, 5vw, 56px);
        align-items: start;
        max-width: 1040px;
        margin: 0 auto;
        padding: 6px 0 24px;
    }

    /* ===== ẢNH ===== */
    .detail-image {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 400px;
        padding: 40px;
        border-radius: var(--gs-r-lg);
        background: linear-gradient(150deg, #f4f8ff, #dfeaff);
        box-shadow: var(--gs-sh-md);
    }

        .detail-image::before {
            content: "";
            position: absolute;
            top: -60px;
            right: -60px;
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: rgba(26, 155, 215, .14);
        }

        .detail-image img {
            position: relative;
            z-index: 1;
            max-width: 100%;
            max-height: 320px;
            object-fit: contain;
            border-radius: var(--gs-r-sm);
            filter: drop-shadow(0 14px 22px rgba(16, 40, 120, .25));
            transition: transform .4s ease;
        }

        .detail-image:hover img {
            transform: scale(1.05);
        }

    /* ===== THÔNG TIN ===== */
    .detail-info {
        display: flex;
        flex-direction: column;
        gap: 18px;
        min-width: 0;
    }

    .detail-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        width: fit-content;
        padding: 6px 14px;
        border-radius: 999px;
        background: var(--gs-blue-100);
        color: var(--gs-blue-700);
        font-size: 13px;
        font-weight: 600;
    }

    .detail-info h1 {
        margin: 0;
        font-size: clamp(1.5rem, 2.8vw, 2rem);
        font-weight: 800;
        line-height: 1.3;
        color: var(--gs-ink);
    }

    .detail-price {
        margin: 0;
        font-size: clamp(1.9rem, 3.4vw, 2.4rem);
        font-weight: 800;
        color: var(--gs-price);
        font-variant-numeric: tabular-nums;
    }

    .detail-desc {
        margin: 0;
        padding: 14px 18px;
        border-left: 4px solid var(--gs-blue-500);
        border-radius: 0 var(--gs-r-sm) var(--gs-r-sm) 0;
        background: var(--gs-bg);
        font-size: 15px;
        line-height: 1.75;
        color: var(--gs-text);
    }

    /* ===== BẢNG THÔNG SỐ ===== */
    .detail-meta {
        overflow: hidden;
        border: 1px solid var(--gs-line);
        border-radius: var(--gs-r-md);
        background: #fff;
    }

        .detail-meta table {
            width: 100%;
            border-collapse: collapse;
        }

        .detail-meta td {
            padding: 12px 18px;
            border-bottom: 1px solid var(--gs-line);
            font-size: 14px;
            vertical-align: middle;
            color: var(--gs-text);
        }

        .detail-meta tr:last-child td {
            border-bottom: 0;
        }

        .detail-meta td:first-child {
            width: 1%;
            white-space: nowrap;
            font-weight: 600;
            color: var(--gs-muted);
            background: #fafcff;
            padding-right: 28px;
        }

            .detail-meta td:first-child i {
                width: 22px;
                margin-right: 4px;
                text-align: center;
                color: var(--gs-blue-500);
            }

    /* ===== SỐ LƯỢNG ===== */
    .quantity-row {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .qty-label {
        font-size: 14px;
        font-weight: 600;
        color: var(--gs-ink);
    }

    .qty-control {
        display: inline-flex;
        align-items: center;
        overflow: hidden;
        border: 1px solid var(--gs-line);
        border-radius: 999px;
        background: #fff;
    }

        .qty-control button {
            width: 42px;
            height: 42px;
            border: 0;
            background: transparent;
            color: var(--gs-blue-700);
            font-size: 20px;
            font-weight: 700;
            cursor: pointer;
            transition: background .2s;
        }

            .qty-control button:hover {
                background: var(--gs-blue-100);
            }

        .qty-control input {
            width: 48px;
            height: 42px;
            padding: 0;
            border: 0;
            outline: none;
            background: #fff;
            text-align: center;
            font-size: 15px;
            font-weight: 700;
            color: var(--gs-ink);
            -moz-appearance: textfield;
        }

            .qty-control input::-webkit-outer-spin-button,
            .qty-control input::-webkit-inner-spin-button {
                -webkit-appearance: none;
                margin: 0;
            }

    /* ===== NÚT ===== */
    .btn-group {
        display: flex;
        gap: 12px;
    }

    .btn-cart {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 15px;
        border: 0;
        border-radius: var(--gs-r-md);
        background: linear-gradient(135deg, var(--gs-blue-500), var(--gs-blue-700));
        color: #fff;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: .02em;
        cursor: pointer;
        box-shadow: 0 12px 22px -10px rgba(10, 60, 255, .7);
        transition: transform .2s, box-shadow .2s, filter .2s;
    }

        .btn-cart:hover {
            transform: translateY(-2px);
            filter: brightness(1.06);
            box-shadow: 0 16px 26px -10px rgba(10, 60, 255, .75);
        }

        .btn-cart:active {
            transform: translateY(0);
        }

    .btn-wishlist {
        width: 56px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1.5px solid #fbc3cf;
        border-radius: var(--gs-r-md);
        background: #fff;
        color: var(--gs-price);
        font-size: 20px;
        transition: background .2s, color .2s, border-color .2s, transform .2s;
    }

        .btn-wishlist:hover {
            transform: translateY(-2px);
            border-color: var(--gs-price);
            background: var(--gs-price);
            color: #fff;
        }

    /* ===== THÔNG BÁO ===== */
    .toast-msg {
        display: none;
        position: fixed;
        right: 30px;
        bottom: 100px;
        z-index: 9999;
        max-width: calc(100vw - 60px);
        padding: 14px 22px;
        border-radius: var(--gs-r-md);
        background: linear-gradient(135deg, var(--gs-blue-500), var(--gs-blue-700));
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        box-shadow: var(--gs-sh-lg);
        animation: slideUp .3s ease;
    }

        .toast-msg.error {
            background: linear-gradient(135deg, #e11d48, #b4123a);
        }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (max-width: 860px) {
        .detail-wrapper {
            grid-template-columns: 1fr;
        }

        .detail-image {
            min-height: 300px;
            padding: 28px;
        }

            .detail-image img {
                max-height: 240px;
            }
    }

    @@media (max-width: 480px) {
        .detail-meta td {
            padding: 10px 12px;
            font-size: 13px;
        }

            .detail-meta td:first-child {
                padding-right: 14px;
            }

        .toast-msg {
            right: 16px;
            left: 16px;
            bottom: 90px;
            max-width: none;
        }
    }
</style>

<a href="javascript:history.back()" class="btn-back">
    <i class="fa-solid fa-arrow-left"></i> Quay lại
</a>

<div class="detail-wrapper">

    <!-- ẢNH -->
    <div class="detail-image">
        <img src="@Url.Content("~/Images/" + Model.HinhAnh)" alt="@Model.TenSanPham" />
    </div>

    <!-- THÔNG TIN -->
    <div class="detail-info">
        <span class="detail-badge"><i class="fa-solid fa-tag"></i> @Model.Loai</span>

        <h1>@Model.TenSanPham</h1>

        <p class="detail-price">@String.Format("{0:N0}", Model.Gia) VNĐ</p>

        <p class="detail-desc">@Model.MoTa</p>

        <div class="detail-meta">
            <table>
                <tr><td><i class="fa-solid fa-building"></i> Thương hiệu</td><td>@Model.ThuongHieu</td></tr>
                <tr><td><i class="fa-solid fa-flask"></i> Dung tích</td><td>@Model.DungTich</td></tr>
                <tr><td><i class="fa-solid fa-list"></i> Thành phần</td><td>@Model.ThanhPhan</td></tr>
                <tr><td><i class="fa-solid fa-earth-asia"></i> Xuất xứ</td><td>@Model.XuatXu</td></tr>
                <tr><td><i class="fa-solid fa-calendar"></i> Hạn sử dụng</td><td>@Model.HanSuDung</td></tr>
            </table>
        </div>

        <!-- Số lượng + Buttons -->
        <div class="quantity-row">
            <span class="qty-label">Số lượng:</span>
            <div class="qty-control">
                <button type="button" onclick="changeQty(-1)" aria-label="Giảm">−</button>
                <input type="number" id="qty-input" value="1" min="1" max="99" readonly />
                <button type="button" onclick="changeQty(1)" aria-label="Tăng">+</button>
            </div>
        </div>

        <div class="btn-group">
            <button type="button" class="btn-cart" onclick="themVaoGio()">
                <i class="fa-solid fa-cart-shopping"></i> THÊM VÀO GIỎ HÀNG
            </button>
            <a href="@Url.Action("Them", "YeuThich", new { id = Model.Id })" class="btn-wishlist" title="Thêm vào yêu thích" aria-label="Thêm vào yêu thích">
                <i class="fa-solid fa-heart"></i>
            </a>
        </div>

        <!-- Anti-forgery token cho AJAX -->
        @Html.AntiForgeryToken()

        <!-- Toast thông báo -->
        <div id="toast-msg" class="toast-msg" role="status"></div>
    </div>
</div>

@section Scripts {
    <script>
        function changeQty(delta) {
            var input = document.getElementById('qty-input');
            var val = parseInt(input.value) + delta;
            if (val >= 1 && val <= 99) input.value = val;
        }

        function themVaoGio() {
            var soLuong = parseInt(document.getElementById('qty-input').value);
            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '/Cart/ThemVaoGio',
                type: 'POST',
                data: {
                    __RequestVerificationToken: token,
                    id:      @Model.Id,
                    ten:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.TenSanPham))',
                    hinh:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.HinhAnh))',
                    gia:     '@Convert.ToDecimal(Model.Gia).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)',
                    soLuong: soLuong
                },
                success: function (res) {
                    if (res.requireLogin) {
                        if (confirm('Bạn cần đăng nhập để thêm vào giỏ hàng!\nĐăng nhập ngay?'))
                            window.location.href = '/Account/Login';
                        return;
                    }
                    if (res.success) {
                        showToast('Đã thêm ' + soLuong + ' sản phẩm vào giỏ hàng!', 'success');
                        $('#cart-badge').text(res.tongSoLuong).show();
                        $('#cart-count').text(res.tongSoLuong + ' sản phẩm');
                    } else if (res.message) {
                        showToast(res.message, 'error');
                    }
                },
                error: function (xhr) {
                    console.error('ThemVaoGio loi', xhr.status, xhr.responseText);
                    showToast('Có lỗi xảy ra, thử lại!', 'error');
                }
            });
        }

        function showToast(msg, type) {
            var t = document.getElementById('toast-msg');
            t.textContent = msg;
            t.classList.toggle('error', type === 'error');
            t.style.display = 'block';
            setTimeout(function () { t.style.display = 'none'; }, 2800);
        }
    </script>
}
