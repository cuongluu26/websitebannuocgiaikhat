@model Wedsite_LTWW.Models.SanPham

@{
    ViewBag.Title = Model.TenSanPham;
}

<style>
    .hero-feature {
        display: none !important;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 25px;
        color: #0a3cff;
        text-decoration: none;
        font-weight: 600;
        font-size: 14px;
        transition: 0.2s;
    }

        .btn-back:hover {
            text-decoration: underline;
        }

    .detail-wrapper {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 50px;
        align-items: start;
        max-width: 1000px;
        margin: 0 auto;
        padding: 10px 0 40px;
    }

    /* ẢNH */
    .detail-image {
        background: linear-gradient(145deg, #f0f4ff, #e8f0fe);
        border-radius: 24px;
        padding: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 380px;
        box-shadow: 0 8px 30px rgba(10,60,255,0.08);
        position: relative;
        overflow: hidden;
    }

        .detail-image::before {
            content: '';
            position: absolute;
            width: 250px;
            height: 250px;
            background: rgba(26,155,215,0.1);
            border-radius: 50%;
            top: -50px;
            right: -50px;
        }

        .detail-image img {
            max-width: 100%;
            max-height: 300px;
            object-fit: contain;
            position: relative;
            z-index: 1;
            filter: drop-shadow(0 10px 20px rgba(0,0,0,0.15));
            transition: transform 0.4s ease;
        }

        .detail-image:hover img {
            transform: scale(1.05);
        }

    /* INFO */
    .detail-info {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .detail-badge {
        display: inline-block;
        background: linear-gradient(135deg, #1a9bd7, #0a3cff);
        color: white;
        font-size: 12px;
        font-weight: 600;
        padding: 5px 14px;
        border-radius: 20px;
        letter-spacing: 1px;
        width: fit-content;
    }

    .detail-info h1 {
        font-size: 26px;
        font-weight: 800;
        color: #111;
        line-height: 1.3;
        margin: 0;
    }

    .detail-price {
        font-size: 36px;
        font-weight: 800;
        color: #e63946;
        margin: 0;
    }

    .detail-desc {
        color: #666;
        font-size: 15px;
        line-height: 1.8;
        margin: 0;
        padding: 15px;
        background: #fafafa;
        border-left: 4px solid #1a9bd7;
        border-radius: 0 10px 10px 0;
    }

    /* TABLE */
    .detail-meta {
        background: #f8f9ff;
        border-radius: 16px;
        padding: 5px 0;
        border: 1px solid #eef0ff;
    }

        .detail-meta table {
            width: 100%;
            border-collapse: collapse;
        }

        .detail-meta tr:last-child td {
            border-bottom: none;
        }

        .detail-meta td {
            padding: 10px 18px;
            font-size: 14px;
            border-bottom: 1px solid #eef0ff;
            vertical-align: middle;
        }

            .detail-meta td:first-child {
                font-weight: 700;
                color: #444;
                width: 130px;
            }

            .detail-meta td:last-child {
                color: #555;
            }

    /* BUTTONS */
    .btn-group {
        display: flex;
        gap: 12px;
    }

    .btn-cart {
        flex: 1;
        padding: 15px;
        background: linear-gradient(135deg, #1a9bd7, #0a3cff);
        color: white;
        border: none;
        border-radius: 14px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .btn-cart:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(10,60,255,0.3);
        }

    .btn-wishlist {
        padding: 15px 20px;
        background: white;
        color: #e63946;
        border: 2px solid #e63946;
        border-radius: 14px;
        font-size: 20px;
        cursor: pointer;
        transition: 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .btn-wishlist:hover {
            background: #e63946;
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(230,57,70,0.3);
        }

    /* Số lượng */
    .quantity-row {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .qty-label {
        font-weight: 700;
        font-size: 14px;
        color: #444;
    }

    .qty-control {
        display: flex;
        align-items: center;
        border: 2px solid #e0e4ff;
        border-radius: 12px;
        overflow: hidden;
    }

        .qty-control button {
            width: 38px;
            height: 38px;
            border: none;
            background: #f0f4ff;
            font-size: 20px;
            font-weight: 700;
            cursor: pointer;
            color: #0a3cff;
            transition: 0.2s;
        }

            .qty-control button:hover {
                background: #0a3cff;
                color: white;
            }

        .qty-control input {
            width: 48px;
            height: 38px;
            text-align: center;
            border: none;
            font-size: 15px;
            font-weight: 700;
            outline: none;
            background: white;
        }

    /* Toast */
    .toast-msg {
        display: none;
        position: fixed;
        bottom: 30px;
        right: 30px;
        background: linear-gradient(135deg, #1a9bd7, #0a3cff);
        color: white;
        padding: 14px 24px;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 600;
        z-index: 9999;
        box-shadow: 0 8px 25px rgba(10,60,255,0.3);
        animation: slideUp 0.3s ease;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<a href="javascript:history.back()" class="btn-back">
    <i class="fa-solid fa-arrow-left"></i> Quay lại
</a>

<div class="detail-wrapper">

    <!-- ẢNH -->
    <div class="detail-image">
        <img src="@Url.Content("~/Images/" + Model.HinhAnh)" alt="@Model.TenSanPham" />
    </div>

    <!-- THÔNG TIN -->
    <div class="detail-info">
        <span class="detail-badge"><i class="fa-solid fa-tag"></i> @Model.Loai</span>

        <h1>@Model.TenSanPham</h1>

        <p class="detail-price">@String.Format("{0:N0}", Model.Gia) VNĐ</p>

        <p class="detail-desc">@Model.MoTa</p>

        <div class="detail-meta">
            <table>
                <tr><td><i class="fa-solid fa-building"></i> Thương hiệu</td><td>@Model.ThuongHieu</td></tr>
                <tr><td><i class="fa-solid fa-flask"></i> Dung tích</td><td>@Model.DungTich</td></tr>
                <tr><td><i class="fa-solid fa-list"></i> Thành phần</td><td>@Model.ThanhPhan</td></tr>
                <tr><td><i class="fa-solid fa-earth-asia"></i> Xuất xứ</td><td>@Model.XuatXu</td></tr>
                <tr><td><i class="fa-solid fa-calendar"></i> Hạn sử dụng</td><td>@Model.HanSuDung</td></tr>
            </table>
        </div>

        <!-- Số lượng + Buttons -->
        <div class="quantity-row">
            <span class="qty-label">Số lượng:</span>
            <div class="qty-control">
                <button type="button" onclick="changeQty(-1)">−</button>
                <input type="number" id="qty-input" value="1" min="1" max="99" readonly />
                <button type="button" onclick="changeQty(1)">+</button>
            </div>
        </div>

        <div class="btn-group">
            <button type="button" class="btn-cart" onclick="themVaoGio()">
                <i class="fa-solid fa-cart-shopping"></i> THÊM VÀO GIỎ HÀNG
            </button>
            <a href="@Url.Action("Them", "YeuThich", new { id = Model.Id })" class="btn-wishlist">
                <i class="fa-solid fa-heart"></i>
            </a>
        </div>

        <!-- Anti-forgery token cho AJAX -->
        @Html.AntiForgeryToken()

        <!-- Toast thông báo -->
        <div id="toast-msg" class="toast-msg"></div>
    </div>
</div>

<script>
        // Chỉ nạp jQuery nếu _Layout chưa có
        if (!window.jQuery) {
            document.write('<script src="https://code.jquery.com/jquery-3.6.0.min.js"><\/script>');
        }
</script>
<script>
function changeQty(delta) {
    var input = document.getElementById('qty-input');
    var val = parseInt(input.value) + delta;
    if (val >= 1 && val <= 99) input.value = val;
}

function themVaoGio() {
    var soLuong = parseInt(document.getElementById('qty-input').value);
    var token = $('input[name="__RequestVerificationToken"]').val();

    $.ajax({
        url: '/Cart/ThemVaoGio',
        type: 'POST',
        data: {
            __RequestVerificationToken: token,
            id:      @Model.Id,
            ten:     '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.TenSanPham))',
            hinh:    '@Html.Raw(HttpUtility.JavaScriptStringEncode(Model.HinhAnh))',
            gia:     '@Convert.ToDecimal(Model.Gia).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)',
            soLuong: soLuong
        },
        success: function (res) {
            if (res.requireLogin) {
                if (confirm('🔒 Bạn cần đăng nhập để thêm vào giỏ hàng!\nĐăng nhập ngay?'))
                    window.location.href = '/Account/Login';
                return;
            }
            if (res.success) {
                showToast('🛒 Đã thêm ' + soLuong + ' sản phẩm vào giỏ hàng!', 'success');
                $('#cart-badge').text(res.tongSoLuong).show();
                $('#cart-count').text(res.tongSoLuong + ' sản phẩm');
            } else if (res.message) {
                showToast('❌ ' + res.message, 'error');
            }
        },
        error: function (xhr) {
            console.error('ThemVaoGio loi', xhr.status, xhr.responseText);
            showToast('❌ Có lỗi xảy ra, thử lại!', 'error');
        }
    });
}

function showToast(msg, type) {
    var t = document.getElementById('toast-msg');
    t.textContent = msg;
    t.style.background = type === 'error'
        ? 'linear-gradient(135deg,#e63946,#c1121f)'
        : 'linear-gradient(135deg,#1a9bd7,#0a3cff)';
    t.style.display = 'block';
    setTimeout(function () { t.style.display = 'none'; }, 2800);
}
</script>
