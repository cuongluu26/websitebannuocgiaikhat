@{
    ViewBag.Title = "Chi tiết sản phẩm";
}

<link href="~/Content/chitiet.css" rel="stylesheet" />

<div class="product-detail-wrapper">

    <div class="product-detail-container">

        <!-- Ảnh sản phẩm -->
        <div class="product-image">
            <img src="~/Images/dua.png" alt="Nước thơm ép" />
        </div>

        <!-- Thông tin sản phẩm -->
        <div class="product-info">
            <h1>NƯỚC THƠM ÉP VINUT</h1>

            <p class="price">20.000 VNĐ</p>

            <p class="description">
                Nước ép thơm tự nhiên, giàu vitamin C,
                đóng lon 330ml, sản xuất theo tiêu chuẩn xuất khẩu.
            </p>

            <button class="btn-add">THÊM VÀO GIỎ HÀNG</button>
        </div>

    </div>

</div>
