@{
    ViewBag.Title = "Giới thiệu";
}

@* Trước đây file này là 1 trang HTML đầy đủ (<html><body>) + font Poppins (không có dấu tiếng Việt).
    Nay là view bình thường nằm trong _Layout, CSS chỉ áp dụng trong .about-page. *@

<style>
    .about-page {
        --muted: #667085;
    }

        .about-page .about-item {
            display: grid;
            grid-template-columns: 1.05fr 1fr;
            gap: clamp(32px, 6vw, 90px);
            align-items: center;
            margin-bottom: clamp(64px, 10vw, 130px);
        }

            .about-page .about-item:last-child {
                margin-bottom: 0;
            }

            .about-page .about-item.reverse .about-image {
                order: 2;
            }

        /* ===== Cụm 2 ảnh chồng nhau (co giãn theo khung, không dùng px cố định) ===== */
        .about-page .about-image {
            position: relative;
            aspect-ratio: 1 / .95;
            width: 100%;
        }

        .about-page .bg-image,
        .about-page .main-image {
            position: absolute;
            object-fit: cover;
            border-radius: var(--gs-r-lg);
            transition: transform .7s ease, box-shadow .7s ease;
        }

        .about-page .bg-image {
            left: 0;
            bottom: 0;
            width: 72%;
            height: 68%;
            z-index: 1;
            box-shadow: 0 20px 44px -18px rgba(16, 40, 120, .3);
        }

        .about-page .main-image {
            right: 0;
            top: 0;
            width: 74%;
            height: 76%;
            z-index: 2;
            box-shadow: 0 28px 56px -20px rgba(16, 40, 120, .45);
        }

        .about-page .about-item.reverse .bg-image {
            left: auto;
            right: 0;
        }

        .about-page .about-item.reverse .main-image {
            right: auto;
            left: 0;
        }

        .about-page .about-image:hover .main-image {
            transform: translateY(-14px) scale(1.02);
        }

        .about-page .about-image:hover .bg-image {
            transform: translateY(10px) scale(.99);
        }

        /* ===== Nội dung ===== */
        .about-page .about-heading {
            scroll-margin-top: 120px;
            margin: 0 0 clamp(20px, 3vw, 36px);
            font-size: clamp(2.1rem, 4.6vw, 3.8rem);
            font-weight: 300;
            line-height: 1.1;
            letter-spacing: -0.02em;
            color: var(--gs-ink);
        }

        .about-page .about-content p {
            margin: 0 0 22px;
            font-size: clamp(1rem, 1.5vw, 1.2rem);
            font-weight: 400;
            line-height: 1.9;
            color: var(--muted);
        }

        .about-page .about-content strong {
            font-weight: 600;
            color: var(--gs-blue-900);
        }

        .about-page .shop-btn {
            display: inline-block;
            margin-top: 8px;
            padding: 14px 36px;
            border: 1.5px solid var(--gs-blue-700);
            border-radius: 999px;
            background: #fff;
            color: var(--gs-blue-700);
            font-size: 14px;
            font-weight: 700;
            letter-spacing: .06em;
            transition: background .25s, color .25s, transform .25s;
        }

            .about-page .shop-btn:hover {
                background: var(--gs-blue-700);
                color: #fff;
                transform: translateY(-3px);
            }

    @@media (max-width: 900px) {
        .about-page .about-item {
            grid-template-columns: 1fr;
        }

            .about-page .about-item.reverse .about-image {
                order: 0;
            }

        .about-page .about-image {
            max-width: 560px;
            margin: 0 auto;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .about-page .bg-image,
        .about-page .main-image {
            transition: none;
        }
    }
</style>

<div class="about-page">

    <!-- ================= TẦM NHÌN ================= -->
    <div class="about-item">

        <div class="about-image">
            <img src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?q=80&w=1600&auto=format&fit=crop"
                 class="bg-image" alt="" loading="lazy">
            <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?q=80&w=1200&auto=format&fit=crop"
                 class="main-image" alt="Tầm nhìn Gas Spark" loading="lazy">
        </div>

        <div class="about-content">
            <h2 class="about-heading" id="tam-nhin-su-menh">Tầm Nhìn</h2>

            <p>
                Trở thành một trong những nhà sản xuất nước giải khát
                hàng đầu Việt Nam, không ngừng nâng tầm thương hiệu
                trên thị trường quốc tế.
            </p>

            <p>
                <strong>"GAS SPARK – Thương hiệu Việt phục vụ toàn cầu"</strong>
            </p>

        </div>

    </div>

    <!-- ================= SỨ MỆNH ================= -->
    <div class="about-item reverse">

        <div class="about-image">
            <img src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?q=80&w=1600&auto=format&fit=crop"
                 class="bg-image" alt="" loading="lazy">
            <img src="https://images.unsplash.com/photo-1493246507139-91e8fad9978e?q=80&w=1200&auto=format&fit=crop"
                 class="main-image" alt="Sứ mệnh Gas Spark" loading="lazy">
        </div>

        <div class="about-content">
            <h2 class="about-heading">Sứ Mệnh</h2>

            <p>
                Mang đến cho khách hàng những sản phẩm chất lượng,
                an toàn và giàu giá trị dinh dưỡng từ thiên nhiên.
            </p>

            <p>
                Không ngừng đổi mới để tạo ra trải nghiệm tốt nhất
                cho người tiêu dùng trong và ngoài nước.
            </p>

        </div>

    </div>

    <!-- ================= GIÁ TRỊ CỐT LÕI ================= -->
    <div class="about-item">

        <div class="about-image">
            <img src="https://images.unsplash.com/photo-1470770841072-f978cf4d019e?q=80&w=1600&auto=format&fit=crop"
                 class="bg-image" alt="" loading="lazy">
            <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?q=80&w=1200&auto=format&fit=crop"
                 class="main-image" alt="Giá trị cốt lõi Gas Spark" loading="lazy">
        </div>

        <div class="about-content">
            <h2 class="about-heading" id="gia-tri-cot-loi">Giá Trị Cốt Lõi</h2>

            <p>
                Chất lượng – Uy tín – Đổi mới – Khách hàng là trung tâm
                chính là nền tảng phát triển bền vững của GAS SPARK.
            </p>

            <p>
                Chúng tôi luôn hướng đến sự minh bạch, sáng tạo
                và trách nhiệm với cộng đồng.
            </p>

        </div>

    </div>

</div>
