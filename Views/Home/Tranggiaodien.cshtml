@model List<Wedsite_LTWW.Models.SanPham>

@* Đã bỏ link sanpham.css: giao diện thẻ sản phẩm nay nằm trong site.css *@

<h2 class="section-title">Danh sách sản phẩm</h2>

<div class="product-container" id="product-container">

    @foreach (var item in Model)
    {
        <div class="product-card">
            <a href="@Url.Action("SanPham","Home", new { id = item.Id })">

                <div class="product-image">
                    <img src="@Url.Content("~/Images/" + item.HinhAnh)" alt="@item.TenSanPham" />
                </div>

                <div class="product-name">
                    @item.TenSanPham
                </div>

                <div class="product-price">
                    @item.Gia.ToString("N0") VNĐ
                </div>

            </a>
        </div>
    }
</div>

<div class="load-more-wrapper">
    <button type="button" id="loadMoreBtn" class="load-more-btn">
        HIỂN THỊ THÊM
    </button>
</div>

@section Scripts {
    <script>
        var page = 2;

        $("#loadMoreBtn").click(function () {
            var btn = $(this);
            btn.prop("disabled", true).text("ĐANG TẢI...");

            $.ajax({
                url: '@Url.Action("LoadMore", "Home")',
                type: 'GET',
                data: { page: page },
                success: function (data) {
                    if (data.trim() === "") {
                        btn.hide();
                    } else {
                        $("#product-container").append(data);
                        page++;
                        btn.prop("disabled", false).text("HIỂN THỊ THÊM");
                    }
                },
                error: function () {
                    btn.prop("disabled", false).text("HIỂN THỊ THÊM");
                    alert("Có lỗi xảy ra!");
                }
            });
        });
    </script>
}
