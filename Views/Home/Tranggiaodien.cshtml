@model List<Wedsite_LTWW.Models.SanPham>

<link href="~/Content/sanpham.css" rel="stylesheet" />

<h2 class="title">DANH SÁCH SẢN PHẨM</h2>

<div class="product-container" id="product-container">

    @foreach (var item in Model)
    {

        <div class="product-card">
            <a href="@Url.Action("SanPham","Home", new { id = item.Id })">

                <div class="product-image">
                    <img src="@Url.Content("~/Images/" + item.Hinh)" alt="@item.Ten" />
                </div>

                <div class="product-name">
                    @item.Ten
                </div>

                <div class="product-price">
                    @item.Gia.ToString("N0") VNĐ
                </div>

            </a>
        </div>
    }
</div>
<div class="load-more-wrapper">
    <button id="loadMoreBtn" class="load-more-btn">
        HIỂN THỊ THÊM
    </button>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    let page = 2;

    $("#loadMoreBtn").click(function () {

        $.ajax({
            url: '@Url.Action("LoadMore", "Home")',
            type: 'GET',
            data: { page: page },
            success: function (data) {

                if (data.trim() === "") {
                    $("#loadMoreBtn").hide();
                }
                else {
                    $("#product-container").append(data);
                    page++;
                }
            },
            error: function () {
                alert("Có lỗi xảy ra!");
            }
        });

    });
  </script>
