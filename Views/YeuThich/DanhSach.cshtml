@model List<Wedsite_LTWW.Models.YeuThich>

<style>
    .hero-feature {
        display: none !important;
    }

    .yeuthich-header {
        background: linear-gradient(135deg, #e63946, #ff6b6b);
        padding: 30px;
        text-align: center;
        margin: -25px -50px 30px -50px;
        color: white;
    }

        .yeuthich-header h2 {
            font-size: 28px;
            font-weight: 800;
            margin: 0;
        }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 25px;
    }

    .product-card {
        background: #fff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,0.08);
        transition: all 0.3s;
        border: 1px solid #f0f0f0;
        position: relative;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(230,57,70,0.15);
            border-color: #e63946;
        }

    .product-image {
        background: #f8f9ff;
        padding: 20px;
        text-align: center;
        height: 180px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .product-image img {
            max-height: 140px;
            max-width: 100%;
            object-fit: contain;
        }

    .product-info {
        padding: 15px;
    }

    .product-name {
        font-size: 14px;
        font-weight: 600;
        color: #222;
        margin-bottom: 6px;
    }

    .product-price {
        font-size: 16px;
        font-weight: 700;
        color: #e63946;
        margin-bottom: 12px;
    }

    .btn-detail {
        display: block;
        padding: 8px;
        text-align: center;
        background: linear-gradient(135deg, #1a9bd7, #0a3cff);
        color: white;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        margin-bottom: 8px;
        transition: 0.3s;
    }

        .btn-detail:hover {
            background: linear-gradient(135deg, #ff7b00, #ff3c00);
            color: white;
        }

    .btn-remove {
        display: block;
        padding: 7px;
        text-align: center;
        background: white;
        color: #e63946;
        border: 1.5px solid #e63946;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
    }

        .btn-remove:hover {
            background: #e63946;
            color: white;
        }

    .empty-box {
        text-align: center;
        padding: 80px 20px;
        color: #aaa;
    }

        .empty-box i {
            font-size: 70px;
            color: #ffccd0;
            margin-bottom: 20px;
        }
</style>

<div class="yeuthich-header">
    <h2><i class="fa-solid fa-heart"></i> Sản phẩm yêu thích</h2>
    <p style="margin-top:8px; opacity:0.9">Xin chào, @Session["Username"]</p>
</div>

@if (!Model.Any())
{
    <div class="empty-box">
        <i class="fa-solid fa-heart-crack"></i>
        <p style="font-size:18px">Bạn chưa có sản phẩm yêu thích nào.</p>
        <a href="/" style="color:#0a3cff; font-weight:600">← Về trang chủ</a>
    </div>
}
else
{
    <div class="product-grid">
        @foreach (var item in Model)
        {
            <div class="product-card">
                <div class="product-image">
                    <img src="@Url.Content("~/Images/" + item.SanPham.HinhAnh)" alt="@item.SanPham.TenSanPham" />
                </div>
                <div class="product-info">
                    <p class="product-name">@item.SanPham.TenSanPham</p>
                    <p class="product-price">@String.Format("{0:N0}", item.SanPham.Gia) VNĐ</p>
                    <a href="@Url.Action("SanPham","Home", new { id = item.SanPham.Id })" class="btn-detail">
                        <i class="fa-solid fa-eye"></i> Xem chi tiết
                    </a>
                    <a href="@Url.Action("Xoa","YeuThich", new { id = item.Id })" class="btn-remove">
                        <i class="fa-solid fa-trash"></i> Xóa khỏi yêu thích
                    </a>
                </div>
            </div>
        }
    </div>
}